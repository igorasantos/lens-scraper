{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "types": [
      "vitest/globals",
      "node"
    ],
    "paths": {
      "@app/browser": [
        "./libs/browser/src/index.ts"
      ],
      "@app/browser/*": [
        "./libs/browser/src/*"
      ],
      "@app/config": [
        "./libs/config/src/index.ts"
      ],
      "@app/config/*": [
        "./libs/config/src/*"
      ],
      "@app/site": [
        "./libs/site/src/index.ts"
      ],
      "@app/site/*": [
        "./libs/site/src/*"
      ],
      "@app/queue": [
        "./libs/queue/src/index.ts"
      ],
      "@app/queue/*": [
        "./libs/queue/src/*"
      ],
      "@app/redis-lock": [
        "./libs/redis-lock/src/index.ts"
      ],
      "@app/redis-lock/*": [
        "./libs/redis-lock/src/*"
      ],
      "@app/storage": [
        "./libs/storage/src/index.ts"
      ],
      "@app/storage/*": [
        "./libs/storage/src/*"
      ]
    }
  },
  "files": [],
  "references": [
    {
      "path": "./apps/api/tsconfig.app.json"
    },
    {
      "path": "./apps/worker/tsconfig.app.json"
    },
    {
      "path": "./libs/browser/tsconfig.lib.json"
    },
    {
      "path": "./libs/config/tsconfig.lib.json"
    },
    {
      "path": "./libs/site/tsconfig.lib.json"
    },
    {
      "path": "./libs/queue/tsconfig.lib.json"
    },
    {
      "path": "./libs/redis-lock/tsconfig.lib.json"
    },
    {
      "path": "./libs/storage/tsconfig.lib.json"
    }
  ]
}