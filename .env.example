# QUEUE
KAFKA_BROKERS=localhost:19092
KAFKA_CONSUMER_SESSION_TIMEOUT_MS=60000
KAFKA_TOPIC_RETENTION_MS=3600000
KAFKA_DLQ_RETENTION_MS=604800000
KAFKA_HANDLER_MAX_ATTEMPTS=3
KAFKA_HANDLER_RETRY_BASE_MS=500
QUEUE_PROVIDER=local
# QUEUE_PROVIDER_SQS_QUEUE_URL=
# QUEUE_PROVIDER_PUBSUB_TOPIC=
# QUEUE_PROVIDER_SERVICEBUS_CONNECTION_STRING=

# LOCK
REDIS_URL=redis://localhost:6379
LOCK_TTL_MS=90000
FILE_LOCK_TTL_MS=5000
FILE_LOCK_RETRY_INTERVAL_MS=50
FILE_LOCK_MAX_WAIT_MS=5000
LOCK_PROVIDER=local
# LOCK_PROVIDER_DYNAMODB_TABLE_NAME=
# LOCK_PROVIDER_FIRESTORE_COLLECTION=
# LOCK_PROVIDER_BLOB_LEASE_CONTAINER_URL=

# STORAGE
LOCAL_STORAGE_DIR=../scraped-data
STORAGE_PROVIDER=local
# STORAGE_PROVIDER_S3_BUCKET=
# STORAGE_PROVIDER_GCS_BUCKET=
# STORAGE_PROVIDER_AZURE_BLOB_CONTAINER_URL=

# APPLICATION
WORKER_PORT=3001
MAX_LISTING_PAGES=50
MAX_RECORD_EXTRACTIONS=20
MAX_EXTRACTION_ATTEMPTS=3
FIXED_WAIT_MS=3000
RECORD_DETAIL_WAIT_MIN_SEC=2
RECORD_DETAIL_WAIT_MAX_SEC=5

# BROWSER
BROWSER_HEADLESS=false
BROWSER_PROFILE_DIR=./browser-profile
BROWSER_CLOSE_WAIT_MIN_MS=3000
BROWSER_CLOSE_WAIT_MAX_MS=7000

# SITE
SITE_BASE_LISTING_URL="https://example.com/search?keywords=widget"
SITE_CONFIG_PATH=./config/site.config.example.json
SITE_REQUIRES_LOGIN=false
