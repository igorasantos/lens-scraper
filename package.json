{
  "name": "lens-scraper",
  "version": "0.0.1",
  "description": "a local, rate-limited and session-aware web scraper",
  "author": "Igor Santos (https://github.com/igorasantos)",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/igorasantos/lens-scraper.git"
  },
  "homepage": "https://github.com/igorasantos/lens-scraper#readme",
  "bugs": {
    "url": "https://github.com/igorasantos/lens-scraper/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\" \"scripts/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:worker": "nest start worker --watch",
    "start:prod": "node dist/apps/api/main",
    "lint": "oxlint apps/ libs/ scripts/",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "playwright:install": "playwright install chromium",
    "login:bootstrap": "tsx scripts/bootstrap-login.ts"
  },
  "dependencies": {
    "@confluentinc/kafka-javascript": "^1.10.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.1.2",
    "@nestjs/microservices": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/swagger": "^12.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "eld": "^2.1.0",
    "ioredis": "^6.0.0",
    "joi": "^18.2.5",
    "linkedom": "^0.18.13",
    "playwright": "^1.62.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.1.2",
    "@rspack/core": "^2.2.2",
    "@types/express": "^5.0.0",
    "@types/node": "^24.13.3",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0",
    "webpack-node-externals": "^3.0.0"
  },
  "allowScripts": {
    "@scarf/scarf": false,
    "@confluentinc/kafka-javascript@1.10.0": true,
    "esbuild@0.28.2": true,
    "fsevents": false
  }
}
